# WireGuard Client 部署設定
# 複製為 .env 並修改（每台機器一份）

# 資料目錄（絕對路徑或相對路徑）
# 例：/data/compose/2/data（TrueNAS/已有 compose 專案）、./data（新機器）
DATA_DIR=./data

# 時區
TZ=Asia/Taipei

# Web UI 帳密
ADMIN_USER=admin
ADMIN_PASS=wireguard

# Flask session key（每台機器不同）
SECRET_KEY=wg-ui-2026

# Web UI port
WG_UI_PORT=5080

# wg0 匯入時自動補的固定 ListenPort（避免重啟後 port 飄移）
# ⚠️ 必須與 WireGuard server 已學到的 listen port 一致，
#    否則 UI 重写 conf 後 server 端的 endpoint 停在舊 port，重啟後连不回来。
#    查法：docker exec wireguard-client wg show  → 「listening port」
WG_LISTEN_PORT=51821

# VPN 網段（wg-easy server: 192.168.50.148）
WG_VPN_SUBNET=10.8.0.0/24

# auto-up watcher 檢查 wg_confs 的間隔（秒）
WG_AUTO_UP_INTERVAL=15

# DDNS endpoint 自動刷新間隔（秒）
WG_DNS_INTERVAL=60

# tunnel 已 up 但沒有 handshake 時，幾個 cycle 後重建介面（0 = 不重建）
WG_MAX_FAIL_CYCLES=4

# 容器啟動時移除 host 上残留的 wg 介面（network_mode: host 的孤兒介面問題）。
# 同一 host 上有其他 WireGuard stack 時設為 0。
WG_CLEAN_ORPHANS=1
